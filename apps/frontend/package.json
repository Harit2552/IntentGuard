{
  "name": "@intentguard/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @intentguard/shared",
    "dev": "vite",
    "dev:serve": "vite --host 0.0.0.0",
    "prebuild": "npm run build --workspace @intentguard/shared",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@intentguard/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
